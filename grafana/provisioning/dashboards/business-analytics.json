          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT specialty AS 'Specijalnost', COUNT(*) AS 'Broj radnika' FROM workers GROUP BY specialty ORDER BY COUNT(*) DESC",
          "refId": "A"
