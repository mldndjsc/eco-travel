      "id": 1,
      "type": "text",
      "title": "Accommodation Service - Analitika",
      "gridPos": {"h": 2, "w": 24, "x": 0, "y": 0},
      "options": {
        "content": "## Accommodation Service\nPodaci o smeštajnim jedinicama, sadržajima i sezonskim cenama.",
        "mode": "markdown"
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Distribucija smeštajnih jedinica po tipu",
      "description": "Koliko ima kabina, apartmana i kuća",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 2},
      "datasource": {"type": "mysql", "uid": "mysql-db"},
      "targets": [
        {
          "datasource": {"type": "mysql", "uid": "mysql-db"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT unit_type AS 'Tip', COUNT(*) AS 'Broj' FROM units GROUP BY unit_type ORDER BY Broj DESC",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "value", "percent"],
        "reduceOptions": {
          "values": true,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "tooltip": {"mode": "single"}
      },
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Prosečna cena po noći po tipu smeštaja",
      "description": "Uporedna analiza cena između kabina, apartmana i kuća",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 2},
      "datasource": {"type": "mysql", "uid": "mysql-db"},
      "targets": [
        {
          "datasource": {"type": "mysql", "uid": "mysql-db"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT unit_type AS 'Tip smeštaja', ROUND(AVG(base_price_per_night), 2) AS 'Prosečna cena (EUR)' FROM units GROUP BY unit_type ORDER BY 'Prosečna cena (EUR)' DESC",
          "refId": "A"
        }
      ],
      "options": {
        "xField": "Tip smeštaja",
        "orientation": "auto",
        "reduceOptions": {
          "values": true,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "tooltip": {"mode": "single"},
        "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Popularnost sadržaja (facilities)",
      "description": "Koliko smeštajnih jedinica ima svaki sadržaj",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 2},
      "datasource": {"type": "mysql", "uid": "mysql-db"},
      "targets": [
        {
          "datasource": {"type": "mysql", "uid": "mysql-db"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT f.name AS 'Sadržaj', COUNT(uf.unit_id) AS 'Broj smeštaja', ROUND(f.extra_cost, 2) AS 'Dopunska naplata (EUR)' FROM facilities f LEFT JOIN unit_facilities uf ON f.id = uf.facility_id GROUP BY f.id, f.name, f.extra_cost ORDER BY COUNT(uf.unit_id) DESC",
          "refId": "A"
        }
      ],
      "options": {
        "xField": "Sadržaj",
        "orientation": "auto",
        "reduceOptions": {
          "values": true,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "tooltip": {"mode": "single"},
        "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "text",
      "title": "Maintenance Service - Analitika",
      "gridPos": {"h": 2, "w": 24, "x": 0, "y": 10},
