{
  "id": null,
  "uid": "eco-system-logs",
  "title": "System Observability - Loki Logovi",
  "tags": ["loki", "observability", "accommodation", "maintenance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Volumen logova po servisu",
      "description": "Broj log linija u vremenskom intervalu po servisu",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({app=~\"accommodation-service|maintenance-service|rezervacije-service|finansije-service|auth-service|gateway-service|avanture-service|vodici-service\"} [$__interval])) by (app)",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10, "spanNulls": false}
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Stopa ERROR logova po servisu",
      "description": "Broj ERROR log zapisa u vremenskom intervalu - uočavanje problema",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({app=~\"accommodation-service|maintenance-service|rezervacije-service|finansije-service|auth-service|gateway-service|avanture-service|vodici-service\", level=\"ERROR\"} [$__interval])) by (app)",
          "legendFormat": "{{app}} - ERRORS",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 20, "spanNulls": false}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "accommodation-service - ERRORS"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "maintenance-service - ERRORS"},
            "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Live Log Stream - Svi servisi",
      "description": "Logovi u realnom vremenu sa traceId za pracenje zahteva kroz sve servise",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{app=~\"accommodation-service|maintenance-service|rezervacije-service|finansije-service|auth-service|gateway-service|avanture-service|vodici-service\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      }
    }
  ]
}
