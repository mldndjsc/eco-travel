<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="maintenance-service"/>
    <springProperty scope="context" name="lokiUrl" source="loki.url" defaultValue="http://loki:3100/loki/api/v1/push"/>
    <property name="instanceId" value="${HOSTNAME:-local}"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Console appender with uniform format -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [${appName},%X{traceId:-},%X{spanId:-}] [${instanceId}] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Loki appender - sends logs with metadata labels -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}</url>
        </http>
        <format>
            <label>
                <pattern>app=${appName},instance=${instanceId},level=%level</pattern>
            </label>
            <message>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [${appName},%X{traceId:-},%X{spanId:-}] [${instanceId}] [%thread] %logger{36} - %msg</pattern>
            </message>
        </format>
    </appender>

    <logger name="org.hibernate.SQL" level="DEBUG"/>
    <logger name="org.springframework.amqp" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>
</configuration>
